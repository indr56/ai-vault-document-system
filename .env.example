# Copy to .env and fill in OPENAI_API_KEY:   cp .env.example .env
# Everything else has working defaults; uncomment to override.

OPENAI_API_KEY=

# --- Ports on your machine ---
# API_PORT=9700
# DB_PORT=9701
# REDIS_PORT=9702

# --- Models (see AI_USAGE.md for why these) ---
# CHAT_MODEL=gpt-5.4-mini
# FAST_MODEL=gpt-5.4-nano
# CHAT_REASONING_EFFORT=low   # chat answers think briefly first (reliable arithmetic); empty = off, temperature 0
# EMBEDDING_MODEL=text-embedding-3-small

# --- Auth: a demo user with this API key is created on startup ---
# DEMO_API_KEY=vault-demo-key

# --- Limits ---
# MAX_UPLOAD_MB=25
# RATE_LIMIT_PER_MINUTE=120
# CHAT_RATE_LIMIT_PER_MINUTE=30
# DAILY_TOKEN_QUOTA=2000000

# --- Use LLM_PROVIDER=fake to run fully offline (deterministic fake AI, as in tests) ---
# LLM_PROVIDER=openai
# LOG_LEVEL=INFO
